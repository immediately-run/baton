{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2023"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#host": [
        "./test/hosts/cloudflare.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/global-setup.ts",
    "test/lib",
    "src/local",
    "src/runner",
    "src/defaults",
    "test/hosts/local.ts",
    "test/unit/local-queue.test.ts",
    "test/unit/boundary-host.test.ts",
    "test/unit/cli.test.ts",
    "test/unit/sign.test.ts",
    "test/unit/runner-main.test.ts",
    "test/unit/runner-bundle.test.ts",
    "test/integration/S-BTN-41.runner.test.ts",
    "test/unit/check-traces.test.ts",
    "test/unit/test-course.test.ts",
    "test/unit/stats-size.test.ts",
    "test/model",
    "test/integration/S-BTN-43.defaults.test.ts",
    "test/unit/defaults-cli.test.ts",
    "test/unit/standard-courses.test.ts",
    "test/unit/course-markers.test.ts",
    "test/unit/bounded-git.test.ts",
    "test/integration/S-BTN-104.standard-courses.test.ts",
    "test/integration/S-BTN-105.course-sources.test.ts",
    "test/integration/S-BTN-106.cross-repo-prs.test.ts",
    "test/integration/S-BTN-107.build-app-course.test.ts",
    "test/integration/S-BTN-156.sync-key.test.ts",
    "test/integration/S-BTN-157.busy-sync.test.ts"
  ]
}
