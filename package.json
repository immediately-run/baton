{
  "name": "@immediately-run/baton",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "immediately.run": {
    "content": [
      "tickets",
      "docs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/baton.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "description": "Baton — work-item leases, workers and the factory dashboard, on a Cloudflare Durable Object or as a local Node process (BATON_SPEC §3a).",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "baton": "dist/baton.mjs"
  },
  "scripts": {
    "test": "rm -rf test/.traces && vitest run && npm run model:links && npm run traces && npm run model:quick",
    "test:baton": "vitest run",
    "test:no-quint": "BATON_SKIP_QUINT=1 vitest run && npm run model:links",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.local.json",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli",
    "check:package": "node scripts/check-package.mjs",
    "vendor": "node scripts/vendor.mjs",
    "fixtures": "node scripts/board-fixtures.mjs",
    "dev": "wrangler dev",
    "start:local": "node scripts/start-local.mjs",
    "model": "node model/check.mjs",
    "model:quick": "node model/check.mjs --quick",
    "model:full": "node model/full.mjs",
    "model:pr": "node model/full.mjs --pr",
    "model:links": "node scripts/check-model-links.mjs",
    "traces": "node scripts/check-traces.mjs",
    "model:verify": "node model/verify.mjs",
    "check:wiki": "node scripts/check-wiki.mjs",
    "check:tickets": "node cli/baton.mjs tickets check --repo .",
    "check:spec": "node scripts/check-spec.mjs",
    "ticket": "node scripts/ticket.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@informalsystems/quint": "0.33.0",
    "@mdx-js/mdx": "3.1.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "^4.150.0",
    "yaml": "2.9.1"
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
