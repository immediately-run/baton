{
  "name": "@immediately-run/baton",
  "version": "0.1.4",
  "license": "Apache-2.0",
  "immediately.run": {
    "content": [
      "tickets",
      "docs",
      "spec"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/baton.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "description": "Baton — work-item leases, runners and the factory dashboard, on a Cloudflare Durable Object or as a local Node process (BATON_SPEC §3a).",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "baton": "dist/baton.mjs"
  },
  "scripts": {
    "test": "npm run lint && BATON_SKIP_QUINT=1 vitest run && npm run model:links",
    "pretest": "npm run build:ui",
    "test:full": "rm -rf test/.traces && vitest run && npm run model:links && npm run traces && npm run model:quick",
    "test:baton": "vitest run",
    "pretest:baton": "npm run build:ui",
    "test:load": "npm run build:ui && BATON_SKIP_QUINT=1 BATON_LOAD_TEST=1 vitest run test/load/ --project local",
    "test:no-quint": "npm test",
    "typecheck": "node scripts/typecheck.mjs",
    "pretypecheck": "npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "prebuild:cli": "npm run build:ui",
    "prepack": "npm run build:cli",
    "check:package": "node scripts/check-package.mjs",
    "vendor": "node scripts/vendor.mjs",
    "fixtures": "node scripts/board-fixtures.mjs",
    "dev": "wrangler dev",
    "predev": "npm run build:ui",
    "start:local": "node scripts/start-local.mjs",
    "prestart:local": "npm run build:ui",
    "model": "node model/check.mjs",
    "model:quick": "node model/check.mjs --quick",
    "model:full": "node model/full.mjs",
    "model:pr": "node model/full.mjs --pr",
    "model:links": "node scripts/check-model-links.mjs",
    "traces": "node scripts/check-traces.mjs",
    "model:verify": "node model/verify.mjs",
    "check:wiki": "node scripts/check-wiki.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:tickets": "node cli/baton.mjs tickets check --repo .",
    "spec:impact": "node scripts/spec-tools.mjs impact",
    "spec:index": "node scripts/spec-files.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@immediately-run/mdx-plugins": "0.7.1",
    "@immediately-run/safe-content": "0.1.3",
    "@informalsystems/quint": "0.33.0",
    "@mdx-js/mdx": "3.1.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.11",
    "wrangler": "^4.150.0",
    "yaml": "2.9.1"
  },
  "files": [
    "dist",
    "NOTICE",
    "scripts/cloud-runner.sh",
    "skills/baton-cloud-runner/SKILL.md"
  ]
}
