{
  "start": "filed",
  "start_leg": "implement",
  "end": [
    "merged",
    "archived"
  ],
  "short_waits": [
    "ci"
  ],
  "test_script": "test",
  "stations": {
    "filed": {
      "label": "Filed, no PR yet"
    },
    "pr-open": {
      "label": "PR open"
    },
    "reviewed": {
      "label": "Reviewed"
    },
    "fixed": {
      "label": "Findings addressed"
    },
    "adjudicated": {
      "label": "Open findings adjudicated"
    },
    "merged": {
      "label": "Merged"
    },
    "delivered": {
      "label": "Found already delivered"
    },
    "confirmed": {
      "label": "Already delivered, confirmed by a person"
    },
    "archived": {
      "label": "Confirmed ticket archived"
    }
  },
  "legs": {
    "implement": {
      "from": [
        "filed"
      ],
      "to": [
        "pr-open",
        "delivered"
      ],
      "max_duration": 10800,
      "label": "Implement it and open the PR, or find it delivered"
    },
    "run-tests": {
      "from": [
        "pr-open",
        "fixed"
      ],
      "to": [
        "pr-open",
        "fixed"
      ],
      "max_runs": 30,
      "autonomous": true,
      "label": "Run the deterministic tests"
    },
    "review": {
      "from": [
        "pr-open",
        "fixed",
        "reviewed"
      ],
      "to": "reviewed",
      "max_runs": 3,
      "no_chain_from": [
        "implement",
        "fix"
      ],
      "autonomous": true,
      "label": "Review round"
    },
    "fix": {
      "from": [
        "reviewed",
        "pr-open",
        "fixed"
      ],
      "to": "fixed",
      "max_runs": 30,
      "max_duration": 10800,
      "label": "Fix or answer the findings"
    },
    "adjudicate": {
      "from": [
        "reviewed"
      ],
      "to": "adjudicated",
      "autonomous": true,
      "label": "The owner answers the third round"
    },
    "merge": {
      "from": [
        "reviewed",
        "adjudicated"
      ],
      "to": "merged",
      "autonomous": true,
      "label": "Merge and close the ticket"
    },
    "confirm": {
      "from": [
        "delivered"
      ],
      "to": [
        "confirmed",
        "filed"
      ],
      "kind": "person",
      "asks": "owner",
      "answer_source": "person",
      "max_runs": 3,
      "label": "A person confirms it was already delivered"
    },
    "archive": {
      "from": [
        "confirmed"
      ],
      "to": "archived",
      "requires": {
        "capabilities": [
          "runner:claim-evidence"
        ]
      },
      "label": "Archive the confirmed ticket"
    }
  }
}
