#!/bin/sh
# A leg wrapper (B-95) — the worked example of `.baton/baton.json`'s `agent_wrapper`.
#
# Copy it to `.baton/leg-wrapper`, make it executable, and name it:
#
#   "agent_wrapper": ".baton/leg-wrapper"
#
# The stub splits that string as it splits `agent_command` (quotes, no substitutions) and runs
# the words in front of the agent's own argv, so this script receives the whole leg command —
# the agent's words, then the ticket id, the leg and the checkout — as "$@", and answers as the
# agent would. Batch mode (`bash .baton/leg-wrapper "$@"`) works too.
#
# Two rules (B-95):
# - stdin passes through untouched, and only the agent's stdout is this script's stdout: the
#   stub reads the agent's last line as the answer, so stderr must not join it. (`2>&1` before
#   the pipe would break the answer protocol.)
# - the exit status is the agent's, so the stub knows the leg's work finished.
#
# What the log is for is the repository's to decide: keep it, upload it, expire it. Baton only
# runs this command.
set -eu
ticket="$2"   # after the agent's words: the ticket id, the leg, the checkout
leg="$3"
mkdir -p .baton/logs
# The agent's stdout goes to the answer and the log byte for byte, and the exit status must stay
# the agent's — which a plain pipe hands to `tee`. `set -o pipefail` is not the answer: dash
# (Ubuntu's /bin/sh) exits the whole script on the unknown option before any `|| true` runs,
# and `${PIPESTATUS[…]}` is bash's alone. So the agent runs in a subshell that parks its status
# in a file beside the log, `tee` streams the bytes on whatever the shell is, and this script
# exits with the parked status — POSIX shell, any host.
status="$(mktemp "${TMPDIR:-/tmp}/baton-leg-status.XXXXXX")"
( r=0; "$@" || r=$?; printf '%s\n' "$r" >"$status" ) | tee ".baton/logs/${ticket}-${leg}.log"
exit "$(cat "$status")"
